# Copy to .env — never commit .env

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1

# Local auth for Vertex (Node uses Application Default Credentials, NOT `gcloud auth login`):
#   gcloud auth application-default login
# Or point to a key file (deploy / CI):
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account-key.json
# VERTEX_CHAT_MODEL=gemini-2.0-flash-001

# Optional override if the API is hosted on another origin:
# NEXT_PUBLIC_CHAT_API=https://api.yourdomain.com/api/chat
# NEXT_PUBLIC_CONTACT_API=https://api.yourdomain.com/api/contact

# Contact form (Resend) — https://resend.com/docs/send-with-nodejs
# Local: copy these into .env. Production: Vercel → Project Settings → Environment Variables.
# onboarding@resend.dev can ONLY send to the email on your Resend account.
# Production sender should use a verified domain: https://resend.com/domains
# RESEND_API_KEY=re_xxxxx
# CONTACT_TO_EMAIL=you@example.com
# CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
