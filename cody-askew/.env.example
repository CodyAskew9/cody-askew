# Copy to .env — never commit .env

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1

# Local auth for Vertex (Node uses Application Default Credentials, NOT `gcloud auth login`):
#   gcloud auth application-default login
# Or point to a key file (deploy / CI):
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account-key.json
# VERTEX_CHAT_MODEL=gemini-2.0-flash-001

# Chat API — must match package.json "proxy". (CRA reserves PORT for :3000.)
SERVER_PORT=5001

# CORS_ORIGIN=https://yourdomain.com
# REACT_APP_CHAT_API=https://api.yourdomain.com

# Contact form (Resend) — https://resend.com/docs/send-with-nodejs
# For local testing you can use onboarding@resend.dev as sender;
# production should use a verified domain.
# RESEND_API_KEY=re_xxxxx
# CONTACT_TO_EMAIL=you@example.com
# CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
