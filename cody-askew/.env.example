# Copy to .env — never commit .env

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1

# Local auth for Vertex (Node uses Application Default Credentials, NOT `gcloud auth login`):
#   gcloud auth application-default login
# Or point to a key file (deploy / CI):
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account-key.json
# VERTEX_CHAT_MODEL=gemini-2.0-flash-001

# Chat API — must match package.json "proxy". (CRA reserves PORT for :3000.)
SERVER_PORT=5001

# CORS_ORIGIN=https://yourdomain.com
# REACT_APP_CHAT_API=https://api.yourdomain.com

# Contact form (EmailJS) — https://dashboard.emailjs.com/admin
# Template body uses: {{to_name}}, {{user_email}}, {{message}}
# REACT_APP_EMAILJS_SERVICE_ID=service_xxxxx
# REACT_APP_EMAILJS_TEMPLATE_ID=template_xxxxx   ← from Email Templates (NOT the public key!)
# REACT_APP_EMAILJS_PUBLIC_KEY=xxxxxxxx
# REACT_APP_EMAILJS_TO_NAME=Cody Askew
